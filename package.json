{
  "name": "towing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "towgo": "pnpm --filter towgo start",
    "towgo:go": "pnpm --filter towgo go",
    "towgo:android": "pnpm --filter towgo android",
    "driver": "pnpm --filter towpartner start",
    "driver:go": "pnpm --filter towpartner go",
    "driver:android": "pnpm --filter towpartner android",
    "fleet": "pnpm --filter towfleet-web dev",
    "backend": "pnpm --filter @towing/backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.5",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1114.0"
  }
}
