# Use in-app mocks (default true — console demos with no backend).
#
# MOCKS-OFF (real backend) run:
#   1. cd apps/backend && docker compose up -d --wait
#   2. pnpm db:migrate && pnpm db:seed   (creds: lakshmi@recovery.in / Password123!)
#   3. pnpm backend                      (dev OTP is printed in this terminal)
#   4. NEXT_PUBLIC_USE_MOCKS=false + API_BASE_URL below, then pnpm fleet
# NOTE: NEXT_PUBLIC_* is inlined at build time — production builds bake the
# value in; `next dev` reads it at server start.
NEXT_PUBLIC_USE_MOCKS=true

# Backend base URL for the session routes + BFF proxy (server-side only)
API_BASE_URL=http://localhost:4000

# Dev-only feedback-state overrides ('' | 'empty' | 'error')
NEXT_PUBLIC_MOCK_DASHBOARD_STATE=
NEXT_PUBLIC_MOCK_TRUCKS_STATE=
NEXT_PUBLIC_MOCK_REALTIME_STATE=
NEXT_PUBLIC_MOCK_EARNINGS_STATE=
NEXT_PUBLIC_MOCK_REPORTS_STATE=
# `empty` here means something specific: a FRESH account mid-onboarding, so the
# §9.3.1 wizard and the /settings setup banner can be previewed. The default is
# a fully-onboarded fleet — anything else would put a setup prompt in front of
# every Playwright spec, since NEXT_PUBLIC_* is baked in at build time and the
# whole suite runs against one build.
NEXT_PUBLIC_MOCK_SETTINGS_STATE=

# MapLibre style. Empty = the built-in vendorless basemap: token-coloured
# background + the fleet's service zones, no API key and no external request.
# Set a MapTiler/Stadia/Protomaps style URL to add real tiles.
#
# CAUTION: NEXT_PUBLIC_* is inlined at build time. Leaving this set while
# building the bundle Playwright runs against gives the hermetic smoke a
# network dependency — unset it before that build.
NEXT_PUBLIC_MAP_STYLE_URL=

# NOTE: there is deliberately no NEXT_PUBLIC_WS_URL. The WebSocket origin comes
# from the backend's PUBLIC_WS_URL in the ticket response, so relocating the
# gateway needs no web rebuild.
