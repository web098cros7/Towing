# Use in-app mocks (default true — app demos with no backend, and the
# hermetic Maestro flow runs against this).
#
# MOCKS-OFF (real backend) run:
#   1. cd apps/backend && docker compose up -d --wait && pnpm db:migrate && pnpm db:seed
#   2. pnpm backend                      (dev OTP is printed in this terminal)
#   3. EXPO_PUBLIC_USE_MOCKS=false + EXPO_PUBLIC_API_URL below, then pnpm start
# NOTE: EXPO_PUBLIC_* is inlined at build time by Metro.
EXPO_PUBLIC_USE_MOCKS=false

# Backend base URL. `localhost` works from an iOS simulator and web.
#   Android emulator:  http://10.0.2.2:4000
#   Physical device:   http://<your machine's LAN IP>:4000
EXPO_PUBLIC_API_URL=https://api.mitow.in

# Dev-only feedback-state overrides ('' | 'empty' | 'error')
EXPO_PUBLIC_MOCK_DRIVERS_STATE=
EXPO_PUBLIC_MOCK_BOOKINGS_STATE=
# '' | empty | error — the service catalogue and the fare estimate.
# EXPO_PUBLIC_MOCK_PRICING_STATE also accepts `surge`, which is the only way to
# reach §9.1.5's surge badge in mock mode (no seeded mock zone surges).
EXPO_PUBLIC_MOCK_SERVICES_STATE=
EXPO_PUBLIC_MOCK_PRICING_STATE=
EXPO_PUBLIC_MOCK_ACCOUNT_STATE=
# '' | 'no_drivers'

# Google Sign-In — the SEAM only. This flag shows the "Continue with Google"
# button, but the client OAuth flow is not implemented (its onPress is empty;
# expo-auth-session isn't installed). The backend route POST /v1/auth/social
# is real (Phase 10) and 403s until GOOGLE_OAUTH_CLIENT_IDS is set server-side.
# Deferred until real OAuth client IDs exist — ToBeDoneEhsan.md §0ii,
# SETUP-CHECKLIST.md item 8. Leave this false.
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# GA4 Measurement Protocol. Empty = analytics events still fire, just to the
# console log adapter instead of a real property.
EXPO_PUBLIC_GA4_MEASUREMENT_ID=
EXPO_PUBLIC_GA4_API_SECRET=

# Dev-only feedback states for Phase 16's two new reads.
EXPO_PUBLIC_MOCK_PLACES_STATE=
EXPO_PUBLIC_MOCK_NEARBY_STATE=

# Google Maps SDK key for ANDROID (Phase 16). Empty = <MapPreview /> keeps the
# themed placeholder, because react-native-maps with no key renders a blank grey
# grid with a Google watermark — which looks like the app is broken rather than
# like a map is pending. iOS is unaffected: it renders through Apple Maps with
# no key at all.
#
# NOT the same key as the server's GOOGLE_MAPS_API_KEY. This one ships inside
# the binary and is extractable, so restrict it to the Android package name +
# signing certificate AND to the Maps SDK alone. Places, Geocoding and Distance
# Matrix stay behind our own server proxies. SETUP-CHECKLIST item 7.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# --- Staging (EAS `preview` environment) only. Never set these for production. ---
# Release builds block plain http://; the staging API has no TLS yet. Gates an
# expo-build-properties plugin that sets android.usesCleartextTraffic=true.
EXPO_PUBLIC_ALLOW_CLEARTEXT_HTTP=
# Lets a release build auto-fill the login code from GET /v1/auth/dev/otp
# (requires AUTH_DEV_OTP_ECHO on the server). No SMS provider exists yet.
EXPO_PUBLIC_DEV_OTP_ECHO=
