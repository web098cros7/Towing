{
  "name": "@towing/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx src/db/seed/index.ts --reset",
    "db:seed:load": "tsx src/db/seed/index.ts --reset --scale=10",
    "earnings:rebuild": "tsx src/scripts/rebuild-earnings.ts",
    "sim:locations": "tsx src/scripts/simulate-locations.ts",
    "sim:drivers": "tsx src/scripts/simulate-drivers.ts",
    "bench:dispatch": "tsx src/scripts/bench-dispatch.ts",
    "bench:tracking": "tsx src/scripts/bench-tracking.ts",
    "smoke:realtime": "tsx src/scripts/realtime-load.ts",
    "load:tokens": "tsx src/scripts/mint-load-tokens.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1106.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@sentry/node": "^10.69.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@towing/api-contracts": "workspace:*",
    "bullmq": "^5.81.3",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
