# Copy to .env — values below match apps/backend/docker-compose.yml defaults.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgres://towfleet:towfleet@localhost:5432/towfleet
DATABASE_POOL_MAX=10

# Read-replica seam (Phase 7, §9.3.8 "report queries hit read paths"). LEAVING
# THIS UNSET IS THE NORMAL CASE and is not degraded: the DB_READER handle then
# shares the primary pool object, so there is no second connection to configure.
# Point it at an RDS read replica when capacity calls for it (Phase 9b).
# DATABASE_READ_URL=postgres://towfleet:towfleet@replica:5432/towfleet
DATABASE_READ_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Any 32+ char string works locally. Generate a real one for deploys:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-before-any-real-deploy
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Signs pre-signed file GET/PUT URLs (Phase 11, §3.1 admin document review) —
# same standing as JWT_ACCESS_SECRET above.
FILE_SIGNING_SECRET=dev-only-file-secret-change-me-before-any-real-deploy

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

CORS_ORIGINS=http://localhost:3000

# Realtime (Phase 5). Set REALTIME_ENABLED=false to exercise the §19.2
# degradation ladder: the console drops to 10s REST polling instead of erroring.
REALTIME_ENABLED=true
REALTIME_FLUSH_MS=1000
REALTIME_TICKET_TTL_SECONDS=60
REALTIME_METRICS_DEBOUNCE_MS=2000
# Origin the browser opens the WebSocket against. Handed to the client in the
# ticket response, so moving the gateway needs no web rebuild.
PUBLIC_WS_URL=http://localhost:4000

# Background jobs (Phase 6). QUEUE_ENABLED=false runs the API with no
# workers and no cron — background work is deferred, not lost.
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=4
COMPLIANCE_SWEEP_CRON=0 * * * *
BULK_IMPORT_SYNC_MAX_ROWS=500
BULK_IMPORT_MAX_ROWS=10000

# ── Money: ledger, projection, payouts (Phase 7) ─────────────────────────────

# §14.1's nightly reconciliation. 01:00 IST = 19:30 UTC — after the IST day
# boundary so "yesterday" is closed, in the demand trough. Drift is reported at
# GET /v1/health/ledger and fails the job (raising the queue DLQ alarm).
LEDGER_RECONCILE_CRON=30 19 * * *
# Keep at 0. The invariants are exact by construction, so any non-zero delta is
# a bug; the knob exists for incident triage without a redeploy.
LEDGER_DRIFT_TOLERANCE_PAISE=0
LEDGER_OPS_EMAIL=ops@towing.local

# `dev` is the PERMANENT local path — the same standing as the dev OTP, log
# notification and disk storage adapters. `pnpm backend` and `pnpm db:seed` must
# work with no Razorpay account, forever. Production refuses to boot on `dev`.
PAYOUT_PROVIDER=dev

# §14.4's "min threshold". ₹1,000: Route/IMPS fees are ₹2–5 per transfer, so
# below this the fee is a material share of the transfer. Returned by
# GET /v1/fleet/earnings so the console never hardcodes a second copy.
PAYOUT_MIN_PAISE=100000
# ₹5,00,000 — a units-bug guard, not a product rule.
PAYOUT_MAX_PAISE=50000000

# §19.3's missed-webhook sweep, and how long an un-acknowledged payout waits
# before it is failed (which returns the money to the wallet).
PAYOUT_RECONCILE_CRON=*/5 * * * *
PAYOUT_STUCK_MINUTES=15
# How long the dev adapter takes to settle a payout to `paid`.
PAYOUT_DEV_SETTLE_MS=5000

# HMAC-SHA256 key for POST /v1/webhooks/razorpay. The DEV adapter verifies with
# the same algorithm and the same secret, which is what makes the
# signature-verification path exercised locally rather than only in production.
PAYOUT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me

# Razorpay. ONE merchant and ONE credential pair for BOTH directions: Route
# moves money out (PAYOUT_PROVIDER), the payment gateway takes money in
# (PAYMENT_GATEWAY). Phase 19 added no new credential vars. Each adapter
# validates in its own onModuleInit, never in a constructor (Nest instantiates
# every adapter regardless of which the factory selects).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_MS=5000

# ── Payments in: capture, ledger credit (Phase 19) ─────────────────────────

# `dev` | `razorpay`. SEPARATE from PAYOUT_PROVIDER on purpose: the payment
# gateway and RazorpayX Route are different products with independent
# availability, and one switch for both would mean a payouts outage configuring
# customers out of paying. assertProductionSafety refuses `dev` here for the
# same reason it refuses the dev payout adapter.
PAYMENT_GATEWAY=dev

# How long the dev gateway waits before reporting `captured`. ZERO, unlike
# PAYOUT_DEV_SETTLE_MS's 5000, and the asymmetry is honest: a bank transfer is
# asynchronous by nature, a UPI capture is synchronous from the app's point of
# view. Zero also means the whole chain runs with no queue at all, which is what
# QUEUE_ENABLED=false (the entire test suite) needs. Raise it to watch a booking
# sit in the COMPLETED-but-unpaid state the reconciliation sweep exists for.
PAYMENT_DEV_SETTLE_MS=0

# HMAC key for the PAYMENT half of POST /v1/webhooks/razorpay. Distinct from
# PAYOUT_WEBHOOK_SECRET because the two products are configured in separate
# Razorpay dashboards. The controller verifies against BOTH secrets and routes
# by whichever matched, so configuring one shared secret also works.
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret-change-me

# The reconciliation sweep: a BullMQ repeatable, not a cron job, so N Fargate
# tasks converge on one timer via Redis rather than each running their own.
PAYMENT_RECONCILE_CRON=*/5 * * * *

# A payment the gateway never confirms after this long is marked `failed` and
# THE BOOKING STAYS COMPLETED — an honest unpaid state, never a silent paid one.
# Longer than the payout equivalent because a customer can legitimately leave a
# UPI collect request pending in their bank app.
PAYMENT_STUCK_MINUTES=30

# Weekly driver earnings digest. 03:30 UTC Monday = 09:00 IST, so it lands in a
# driver's morning rather than overnight.
EARNINGS_WEEKLY_CRON=30 3 * * 1

# ── Hardening: multi-instance, observability (Phase 8) ───────────────────────

# How many reverse proxies sit in front of this process (Express `trust proxy`).
# 0 = trust nothing, so req.ip is the socket peer and no client can influence it.
# Set to 1 behind a single ALB — and no higher than the real hop count, or the
# X-Forwarded-For entry the CLIENT wrote becomes req.ip.
# For the local 2-instance rehearsal (docs/rehearsal.md) this is 1.
TRUST_PROXY_HOPS=0

# Rotation leeway (§16.4): N parallel console queries all refresh with the same
# token, and without a window the losers look like token theft. 0 disables it.
REFRESH_GRACE_SECONDS=10

# Per-minute throttle budgets, one per bucket. Phase 8 made these mean what they
# say — the previous key included the handler name, so `reads` was really its
# limit per endpoint. Tunable because the right numbers are load evidence.
THROTTLE_READS_LIMIT=300
THROTTLE_MONEY_LIMIT=20
THROTTLE_AUTH_LIMIT=5
THROTTLE_REFRESH_LIMIT=30
THROTTLE_REALTIME_LIMIT=60

# Queries at or above this are logged at warn with the request id and truncated
# SQL — never the parameters. 200 ms is the §19.1 p95 budget for a whole
# request, so any single query this slow can blow the SLO alone. 0 disables.
DB_SLOW_QUERY_MS=200
DB_SLOW_QUERY_SQL_MAX=300

# GET /v1/metrics (prom-client). Set METRICS_TOKEN to require a bearer token;
# unset leaves it open like /v1/health, which is why it should not be
# internet-reachable without one.
METRICS_ENABLED=true
# METRICS_TOKEN=

# Unset ⇒ the noop error reporter is bound and nothing is sent anywhere.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging

# Exposes GET /v1/{fleet,admin}/auth/dev/otp and /v1/auth/dev/otp?challengeId=…
# so the mocks-off Playwright run can complete the two-step login. Keyed on the
# challenge id, so valid credentials are still required first. Production
# refuses to boot with it on.
AUTH_DEV_OTP_ECHO=false

# --- Social sign-in (Phase 10) -----------------------------------------------

# Accepted `aud` values for a Google ID token, comma-separated. There are
# normally THREE — the web, iOS and Android OAuth clients each have their own id.
# Left empty, Google sign-in reports itself disabled and POST /v1/auth/social
# refuses it, which is the right default: an unpinned audience would let any
# Google ID token from any app in the world log in here.
# GOOGLE_OAUTH_CLIENT_IDS=1234-web.apps.googleusercontent.com,5678-ios.apps.googleusercontent.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_JWKS_TIMEOUT_MS=3000
GOOGLE_JWKS_CACHE_SECONDS=3600

# Sign in with Apple (§9.1, App Store Guideline 4.8). SHIPS OFF.
#
# Phase 13 made the adapter REAL — it verifies against Apple's JWKS with the
# same ES256 pinning the Google one does for RS256, and has its own 14-case
# spec including the algorithm-confusion attack. What it has never seen is a
# token Apple actually minted, because organisation enrolment (D-U-N-S, weeks)
# has not completed. See ToBeDoneEhsan.md §0i.
#
# Turning it on needs BOTH the flag and the client ids: production refuses to
# boot with the flag on and no APPLE_CLIENT_IDS, because an unpinned audience
# would accept any Apple ID token from any app in the world.
APPLE_LOGIN_ENABLED=false
# The iOS bundle id, plus any Services ID used by a web flow.
# APPLE_CLIENT_IDS=in.mitow.customer,in.mitow.customer.web
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_JWKS_TIMEOUT_MS=3000
APPLE_JWKS_CACHE_SECONDS=3600

# --- OTP send limits (Phase 10) ----------------------------------------------

# Per-mobile caps on top of the `auth` throttle bucket. The bucket is a burst
# limit (5/min) protecting the endpoint; these bound the SMS bill, which 5/min
# does not — sustained, that is 7,200 messages a day to one handset.
OTP_SEND_WINDOW_SECONDS=86400
OTP_SEND_MAX_PER_WINDOW=10
# Resend cooldown. Returned to the client as `resendAfterSeconds` so the app's
# timer matches the server's rule rather than guessing it.
OTP_SEND_MIN_INTERVAL_SECONDS=30

# --- Notifications spine (Phase 13, §12) --------------------------------------

# OUTBOUND delivery only. Off means events are still recorded and the in-app
# notification centre is still written — every delivery row is just stamped
# `skipped/notifications_disabled`. It exists so a vendor incident or a load run
# is one flag rather than four unbound adapters.
NOTIFY_ENABLED=true

# FOUR SWITCHES, NOT ONE, because the four credential sets arrive months apart:
# Firebase and SES production access are separate procurement items, MSG91 needs
# DLT template registration, WhatsApp needs a BSP plus Meta template approval.
# `log` is the PERMANENT zero-credential path — the same standing as the dev OTP
# and disk storage adapters. The whole spine stays demonstrable with no vendor
# account, forever. Production WARNS about channels left on `log`; it does not
# refuse, because that would make procurement a launch blocker.
NOTIFY_PUSH_PROVIDER=log
NOTIFY_SMS_PROVIDER=log
NOTIFY_WHATSAPP_PROVIDER=log
NOTIFY_EMAIL_PROVIDER=log

# §19.3's external-call budget, applied to EVERY vendor call — Maps, MSG91,
# FCM, WhatsApp, SES, Razorpay. A hung provider socket must not park a queue
# worker. Renamed from NOTIFY_* in Phase 14, when the second consumer appeared.
EXTERNAL_CALL_TIMEOUT_MS=5000
EXTERNAL_CALL_BREAKER_THRESHOLD=5
EXTERNAL_CALL_BREAKER_RESET_MS=30000

# ── Routing / road distance (Phase 14) ───────────────────────────────────────
# §7 prices on road distance and §11.5 quotes ETAs from it.
#
# `haversine` is the LIVE DEFAULT and a real §19.2 path, not a stub: no Google
# Maps key exists yet (SETUP-CHECKLIST item 7), and a great-circle distance
# scaled by `charge_config.haversine_road_factor` is a defensible fare. The
# Distance Matrix adapter is written and unit-tested and has never called
# Google. Switch the provider the moment a key exists — production REFUSES to
# boot on `google_distance_matrix` with no key, because that is a
# misconfiguration rather than a deferral.
ROUTING_PROVIDER=haversine
# GOOGLE_MAPS_API_KEY=
GOOGLE_DISTANCE_MATRIX_URL=https://maps.googleapis.com/maps/api/distancematrix/json

# Deliberately tighter than §19.3's 2–5 s: this call sits inside
# POST /pricing/estimate, which §7.6 caps at 2 s. At 1.5 s a timeout still
# leaves room to fall back to Haversine and answer inside the guarantee.
ROUTING_TIMEOUT_MS=1500

# Repairs work stranded by a crash between a commit and its enqueue.
NOTIFY_SWEEP_CRON=*/5 * * * *
NOTIFY_STRANDED_MINUTES=5

# Expo push (FCM on Android, APNs on iOS). Sending needs no credential — the
# access token only raises rate limits — but a push that ARRIVES needs an FCM
# server key and an APNs key uploaded to the Expo project. Neither exists yet.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
# EXPO_ACCESS_TOKEN=
# Expo reports `DeviceNotRegistered` on the RECEIPTS endpoint minutes after the
# send, never in the ticket. Polling it is the only thing that ever prunes a
# token belonging to an uninstalled app.
EXPO_RECEIPT_DELAY_MS=900000

# MSG91 SMS. Every transactional template must be DLT-registered with the
# regulator and referenced by id; an unregistered template is refused before the
# call rather than 4xx'd by the provider.
MSG91_BASE_URL=https://control.msg91.com
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# WhatsApp Cloud API. Outside a 24-hour customer-initiated window only
# Meta-approved TEMPLATES may be sent, so every §12.2 row here is a template
# send and an unapproved one cannot fall back to free text.
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Amazon SES. Credentials come from the standard AWS chain. Production refuses
# to boot with NOTIFY_EMAIL_PROVIDER=ses and this still on the .local placeholder.
SES_REGION=ap-south-1
SES_FROM_EMAIL=no-reply@towing.local

# --- Driver presence & the location pipeline (Phase 16, §11.2/§11.3) ---------

# How often driver pings are written through to Postgres. NOT the same knob as
# REALTIME_FLUSH_MS, which coalesces SOCKET frames on a ~1s window: this one
# governs DATABASE writes and is two orders of magnitude slower on purpose.
# 30s matches the driver hash TTL, so the authoritative row is never more stale
# than the hot key it backs up.
LOCATION_FLUSH_MS=30000

# --- Address search (Phase 16, §9.1.5) --------------------------------------

# `local` is the LIVE DEFAULT and a first-class §19.2 path, not a stub: no
# Places key exists (SETUP-CHECKLIST item 7), and a gazetteer over the two
# seeded cities exercises the whole typed-address flow end to end.
# `google_places` is written and unit-tested but has never called Google.
#
# A SEPARATE SWITCH from ROUTING_PROVIDER even though both spend the same key:
# the two APIs are enabled and billed independently in Google Cloud, so a
# project with Distance Matrix on and Places off is a real configuration.
# Production refuses to boot on `google_places` with no GOOGLE_MAPS_API_KEY.
GEOCODING_PROVIDER=local
GOOGLE_PLACES_URL=https://maps.googleapis.com/maps/api/place
GOOGLE_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json

# Tight because a HUMAN IS TYPING, not because of a §7.6-style guarantee: a
# suggestion list that lands after the next keystroke has already been sent is
# worse than no list, and the gazetteer replies in microseconds.
GEOCODING_TIMEOUT_MS=1200

# ---------------------------------------------------------------------------
# Phase 18 — job execution, live tracking & share trip
# ---------------------------------------------------------------------------

# §11.4/§11.5 route lines and ETAs. A THIRD Maps switch, on the argument
# GEOCODING_PROVIDER already won: Directions is enabled and billed independently
# of Distance Matrix in Google Cloud (it is currently enabled and DORMANT on the
# project — SETUP-CHECKLIST item 7), so "routes on, fare distances off" is a real
# configuration somebody will want on the day the Directions bill surprises them.
# `haversine` is a first-class §19.2 path, not a stub. Production refuses to boot
# on `google_directions` with no GOOGLE_MAPS_API_KEY.
DIRECTIONS_PROVIDER=haversine
GOOGLE_DIRECTIONS_URL=https://maps.googleapis.com/maps/api/directions/json

# §19.3's FULL 2-5s band, deliberately looser than ROUTING_TIMEOUT_MS's 1.5s.
# Distance Matrix runs inside §7.6's 2-second estimate guarantee with a customer
# waiting on a price; this runs once at assignment, on a screen that works
# without it. Nothing is blocked, so patience is cheap and a route obtained
# slowly beats a straight line for the whole trip.
DIRECTIONS_TIMEOUT_MS=4000

# §19.8 KILL SWITCH for the one thing in this system billed per call on an
# account with NO HARD SPEND CAP (both cap routes were checked and both are
# closed for Maps). Off means every trip still gets a route line and an ETA;
# they are straight and labelled `haversine`. That is a degradation, not an
# outage, and it is reachable without a deploy at two in the morning.
DIRECTIONS_ENABLED=true

# Great-circle -> road correction for the FALLBACK ETA, mirroring §7.4's
# charge_config.haversine_road_factor (which stays a pricing knob and lives with
# the other rates). Measured over seven real Bengaluru/Chennai routes: mean
# 1.307, median 1.304, spread 1.203-1.419.
HAVERSINE_ROUTE_FACTOR=1.3

# Assumed average speed for the straight-line ETA, km/h. Urban Indian traffic
# with a tow truck, deliberately pessimistic: §11.5's whole purpose is that the
# number does not lurch upward later, and an ETA that improves is a much better
# experience than one that slips.
FALLBACK_SPEED_KPH=22

# §11.7's share page origin. The /t/{token} URL is composed SERVER-SIDE and
# returned whole, exactly as wsUrl rides the realtime ticket response —
# relocating the page must not need a mobile release, and two apps composing it
# themselves would eventually compose it differently. Production refuses to boot
# on a localhost value: a link that says http://localhost:3000 is not merely
# broken but confusing, and it is unrecoverable once somebody has sent it.
PUBLIC_TRACK_BASE_URL=http://localhost:3000

# §11.7's "expires when the trip completes (+30 min grace)".
SHARE_LINK_GRACE_MINUTES=30

# §9.1.7/§9.2.3's masked calling. `direct` is the permanent LOCAL path and the
# live default — but unlike `haversine` or `local` it is NOT a first-class §19.2
# rung, and production refuses to boot on it. A straight-line ETA is a worse
# answer to the same question; a direct dial answers a DIFFERENT one, because it
# hands over a personal phone number the masked path would never have disclosed
# (§20.4). No provider account exists yet — SETUP-CHECKLIST item 13.
TELEPHONY_PROVIDER=direct
EXOTEL_BASE_URL=https://api.exotel.com/v1/Accounts
# EXOTEL_SID=
# EXOTEL_TOKEN=
# EXOTEL_CALLER_ID=
EXOTEL_TIMEOUT_MS=4000
